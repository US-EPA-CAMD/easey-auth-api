{
  "name": "easey-auth-api",
  "version": "2.1",
  "description": "EPA CAMD Authentication & Authorization Management API",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/US-EPA-CAMD/easey-auth-api.git"
  },
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --colors --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "up": "yarn && yarn start:dev"
  },
  "resolutions": {
    "tough-cookie": "^4.1.3",
    "xml2js": "^0.5.0"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.3.1",
    "@nestjs/axios": "^3.1.1",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^8.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "@us-epa-camd/easey-common": "^17.8.0",
    "axios": "^1.7.4",
    "cache-manager": "<=5",
    "class-transformer": "0.4.0",
    "class-validator": "0.14.0",
    "dotenv": "^10.0.0",
    "express": "^4.20.0",
    "form-data": "^4.0.0",
    "js-base64": "^3.7.2",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.1.0",
    "nestjs-cacheable": "^1.0.0",
    "pg": "^8.3.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.4.0",
    "serialize-javascript": "^6.0.2",
    "soap": "^0.39.0",
    "swagger-ui-express": "^4.6.0",
    "typeorm": "0.3.0",
    "uuid": "^8.3.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.3.1",
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^4.17.3",
    "@types/jest": "27.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.11.2",
    "@types/supertest": "^2.0.8",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "5.1.0",
    "@typescript-eslint/parser": "5.1.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.2",
    "jest": "^27.3.1",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^1.19.1",
    "sinon": "^9.2.3",
    "supertest": "^4.0.2",
    "ts-jest": "^27.0.7",
    "ts-loader": "^6.2.1",
    "ts-node": "^8.6.2",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.4.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.config.ts",
      "!**/*.module.ts",
      "!routes.ts",
      "!main.ts"
    ],
    "testResultsProcessor": "jest-sonar-reporter",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ]
  }
}
